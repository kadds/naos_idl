library naos.system;

struct Termios {
    u32 input_flags @id(1);
    u32 output_flags @id(2);
    u32 control_flags @id(3);
    u32 local_flags @id(4);
    u8 line @id(5);
    array<u8, 32> control_chars @id(6);
    u8 padding0 @id(7);
    u8 padding1 @id(8);
    u8 padding2 @id(9);
    u32 input_baud @id(10);
    u32 output_baud @id(11);
};

struct Winsize {
    u16 rows @id(1);
    u16 columns @id(2);
    u16 x_pixels @id(3);
    u16 y_pixels @id(4);
};

struct Readiness {
    u64 ready_mask @id(1);
    u64 hangup_mask @id(2);
    u64 generation @id(3);
};

protocol TerminalMaster @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1016") @revision(1) @features(0) @scope(6) @uapi_name("TERMINAL_MASTER") @scope_name("TERMINAL_MASTER") {
    method read @id(1) @rights(terminal_read) @max_bytes(65536) {
        u64 size @id(1);
        u64 flags @id(2);
    } -> {
        bytes<65536> data @id(1) @inline;
    };
    method write @id(2) @rights(terminal_write) @max_bytes(65536) {
        u64 size @id(1);
        u64 flags @id(2);
        bytes<65536> data @id(3) @inline @length_field("size");
    } -> {
        u64 count @id(1);
    };
    method get_attributes @id(3) @rights(terminal_control) -> {
        Termios attributes @id(1);
    };
    method set_attributes @id(4) @rights(terminal_control) {
        Termios attributes @id(1);
        u64 action @id(2);
    } ->;
    method get_winsize @id(5) @rights(terminal_control) -> {
        Winsize size @id(1);
    };
    method set_winsize @id(6) @rights(terminal_control) {
        Winsize size @id(1);
    } ->;
    method flush @id(7) @rights(terminal_control) {
        u64 queue @id(1);
    } ->;
    method get_input_count @id(8) @rights(terminal_control) -> {
        u64 count @id(1);
    };
    method send_break @id(9) @rights(terminal_control) {
        u64 duration_ms @id(1);
    } ->;
    method query @id(10) @rights(terminal_watch) {
        u64 mask @id(1);
    } -> {
        Readiness readiness @id(1);
    };
    method watch @id(11) @rights(terminal_watch) {
        u64 mask @id(1);
        u64 observed_generation @id(2);
    } -> {
        Readiness readiness @id(1);
    };
    method clone_binding @id(12) @rights(terminal_admin) {
        u64 flags @id(1);
    } -> {
        handle<terminal_master, transfer, move> endpoint @id(1);
    };
    method get_status_flags @id(13) @rights(terminal_control) -> {
        u64 flags @id(1);
    };
    method set_status_flags @id(14) @rights(terminal_control) {
        u64 flags @id(1);
    } ->;
    method shutdown_input @id(15) @rights(terminal_control) ->;
    method get_number @id(16) @rights(terminal_admin) -> {
        u64 number @id(1);
    };
    method unlock @id(17) @rights(terminal_admin) {
        u64 locked @id(1);
    } ->;
    method get_slave_locator @id(18) @rights(terminal_admin) -> {
        u64 pair_id @id(1);
        u64 generation @id(2);
        array<u8, 16> token @id(3);
    };
    method get_job_control @id(19) @rights(terminal_control) -> {
        handle<terminal_job_control, transfer, move> job_control @id(1);
    };
    method set_flow @id(20) @rights(terminal_control) {
        u64 action @id(1);
    } ->;
    method grant_slave @id(21) @rights(terminal_admin) ->;
};
