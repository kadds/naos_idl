library naos.system;

struct Termios {
    u32 input_flags @id(1);
    u32 output_flags @id(2);
    u32 control_flags @id(3);
    u32 local_flags @id(4);
    u8 line @id(5);
    array<u8, 32> control_chars @id(6);
    u8 padding0 @id(7);
    u8 padding1 @id(8);
    u8 padding2 @id(9);
    u32 input_baud @id(10);
    u32 output_baud @id(11);
};

struct Winsize {
    u16 rows @id(1);
    u16 columns @id(2);
    u16 x_pixels @id(3);
    u16 y_pixels @id(4);
};

struct SlaveLocator {
    u64 pair_id @id(1);
    u64 generation @id(2);
    array<u8, 16> token @id(3);
};

protocol TerminalManager @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1015") @revision(1) @features(0) @scope(5) @uapi_name("TERMINAL_MANAGER") @scope_name("TERMINAL_MANAGER") {
    method create_pty @id(1) @max_bytes(65536) {
        Termios attributes @id(1);
        Winsize size @id(2);
        u64 locked @id(3);
        u64 mode @id(4);
    } -> {
        handle<terminal_master, transfer, move> master @id(1);
        SlaveLocator slave_locator @id(2);
        u64 number @id(3);
        handle<terminal_job_control, transfer, move> job_control @id(4);
    };
    method open_pty_slave @id(2) @max_bytes(65536) {
        SlaveLocator locator @id(1);
        u64 mode @id(2);
    } -> {
        handle<terminal_slave, transfer, move> slave @id(1);
        handle<terminal_job_control, transfer, move> job_control @id(2);
    };
    // Device namespace opens resolve the current pair by number. Callers do
    // not cache a per-process locator; capability-oriented opens retain the
    // generation/token validation above.
    method open_pty_slave_by_number @id(6) @max_bytes(65536) {
        u64 number @id(1);
        u64 mode @id(2);
    } -> {
        handle<terminal_slave, transfer, move> slave @id(1);
        handle<terminal_job_control, transfer, move> job_control @id(2);
    };
    method open_console @id(3) @max_bytes(65536) {
        u64 mode @id(1);
    } -> {
        handle<terminal_slave, transfer, move> slave @id(1);
        handle<terminal_job_control, transfer, move> job_control @id(2);
    };
    method open_controlling @id(4) @max_bytes(65536) {
        SlaveLocator locator @id(1);
        u64 mode @id(2);
    } -> {
        handle<terminal_slave, transfer, move> slave @id(1);
        handle<terminal_job_control, transfer, move> job_control @id(2);
    };
    // Bootstrap-only local frontend endpoint for the single physical console.
    // POSIX opens continue to use open_console() and receive a slave binding.
    method open_console_master @id(5) @max_bytes(65536) {
        u64 mode @id(1);
        // Only the explicitly provisioned console frontend may request the
        // physical-console master.  The capability is duplicated for the
        // broker-side validation and remains owned by the frontend.
        handle<resource, transfer, duplicate> frontend @id(2);
    } -> {
        handle<terminal_master, transfer, move> master @id(1);
        handle<terminal_job_control, transfer, move> job_control @id(2);
    };
};
