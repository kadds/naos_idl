library naos.system;

struct JobControlState {
    u64 session @id(1);
    u64 process_group @id(2);
    u64 foreground_process_group @id(3);
    u64 has_controlling_terminal @id(4);
    u64 generation @id(5);
};

protocol TerminalJobControl @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a101c") @revision(1) @features(0) @scope(12) @uapi_name("TERMINAL_JOB_CONTROL") @scope_name("TERMINAL_JOB_CONTROL") {
    method check_io @id(1) {
        u64 direction @id(1);
        u64 tostop @id(2);
    } ->;
    method attach @id(2) {
        u64 force @id(1);
    } ->;
    method detach @id(3) ->;
    method get_pgrp @id(4) -> {
        u64 group @id(1);
    };
    method set_pgrp @id(5) {
        u64 group @id(1);
    } ->;
    method get_sid @id(6) -> {
        u64 session @id(1);
    };
    method query @id(7) -> {
        JobControlState state @id(1);
    };
};
