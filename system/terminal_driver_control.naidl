library naos.system;

enum DriverAction {
    interrupt @id(1);
    quit @id(2);
    suspend @id(3);
};

protocol TerminalDriverControl @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a100d") @revision(1) @features(0) @scope(13) @uapi_name("TERMINAL_DRIVER_CONTROL") @scope_name("TERMINAL_DRIVER_CONTROL") {
    method raise_foreground @id(1) {
        DriverAction action @id(1);
    } ->;
    method notify_winsize_changed @id(2) ->;
    method hangup @id(3) ->;
    method revoke @id(4) ->;
};
