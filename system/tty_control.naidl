library naos.system;

struct Termios {
    u32 input_flags @id(1);
    u32 output_flags @id(2);
    u32 control_flags @id(3);
    u32 local_flags @id(4);
    u8 line @id(5);
    array<u8, 32> control_chars @id(6);
    u8 padding0 @id(7);
    u8 padding1 @id(8);
    u8 padding2 @id(9);
    u32 input_baud @id(10);
    u32 output_baud @id(11);
};

struct Winsize {
    u16 rows @id(1);
    u16 columns @id(2);
    u16 x_pixels @id(3);
    u16 y_pixels @id(4);
};

protocol TtyControl @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1004") @revision(1) @features(0) @scope(4) @uapi_name("TTY") @scope_name("TTY_CONTROL") {
    method get_attributes @id(1) -> {
        Termios attributes @id(1);
    };
    method set_attributes @id(2) {
        Termios attributes @id(1);
    } ->;
    method get_winsize @id(3) -> {
        Winsize size @id(1);
    };
    method set_winsize @id(4) {
        Winsize size @id(1);
    } ->;
    method flush @id(5) {
        u64 queue @id(1);
    } ->;
    method attach @id(6) {
        u64 controlling @id(1);
    } ->;
    method get_pgrp @id(7) -> {
        u64 group @id(1);
    };
    method set_pgrp @id(8) {
        u64 group @id(1);
    } ->;
    method get_sid @id(9) -> {
        u64 session @id(1);
    };
    method detach @id(10) ->;
    method get_input @id(11) -> {
        u64 count @id(1);
    };
    method get_number @id(12) @uapi_name("PTY_GET_NUMBER") -> {
        u64 number @id(1);
    };
    method unlock @id(13) @uapi_name("PTY_UNLOCK") {
        u64 locked @id(1);
    } ->;
};
