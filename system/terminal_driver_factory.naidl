library naos.system;

struct TerminalLocator {
    u64 terminal_id @id(1);
    u64 generation @id(2);
    array<u8, 16> token @id(3);
};

protocol TerminalDriverFactory @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a101e") @revision(1) @features(0) @scope(14) @uapi_name("TERMINAL_DRIVER_FACTORY") @scope_name("TERMINAL_DRIVER_FACTORY") {
    method create @id(1) @max_bytes(65536) {
        u64 mode @id(1);
    } -> {
        TerminalLocator locator @id(1);
        handle<terminal_driver_control, transfer, move> driver @id(2);
        handle<terminal_job_control, transfer, move> job_control @id(3);
    };
    method validate_locator @id(2) @max_bytes(65536) {
        TerminalLocator locator @id(1);
    } -> {
        u64 valid @id(1);
    };
};
