library naos.system;

protocol Process @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a1009") @revision(3) @features(0) @scope(9) @uapi_name("PROCESS") {
    method wait @id(1) {
        u64 flags @id(1);
    } -> {
        i64 status @id(1);
        i64 pid @id(2);
    };
    method get_info @id(2) -> {
        u64 pid @id(1);
        u64 parent_pid @id(2);
        u64 attributes @id(3);
        i64 return_value @id(4);
    };
    method wait_children @id(3) {
        i64 pid @id(1);
        u64 flags @id(2);
    } -> {
        i64 status @id(1);
        i64 pid @id(2);
    };
    method get_job_control_info @id(4) -> {
        i64 session @id(1);
        i64 process_group @id(2);
        i64 foreground_process_group @id(3);
        u64 has_controlling_tty @id(4);
    };
    method set_session @id(5) -> {
        i64 session @id(1);
    };
    method get_process_group @id(6) -> {
        i64 process_group @id(1);
    };
    method set_process_group @id(7) {
        i64 process_group @id(1);
    } ->;
    method get_session @id(8) -> {
        i64 session @id(1);
    };
    method get_controlling_terminal @id(9) -> {
        u64 terminal_id @id(1);
        u64 generation @id(2);
        array<u8, 16> token @id(3);
    };
    method start @id(10) ->;
};
