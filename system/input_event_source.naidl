library naos.system;

struct KeyEvent {
    u64 key_code @id(1);
    u64 modifiers @id(2);
    u64 kind @id(3);
};

protocol InputEventSource @uuid("2b9e3c2e-8c7d-4fb1-9e21-4c4b0e0a100f") @revision(1) @features(0) @scope(15) @uapi_name("INPUT_EVENT_SOURCE") @scope_name("INPUT_EVENT_SOURCE") {
    method subscribe @id(1) @max_bytes(65536) {
        u64 max_events @id(1);
    } -> {
        handle<resource, transfer, move> receiver @id(1);
    };
};
